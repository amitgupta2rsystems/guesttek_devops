# Copy to config.env and adjust for your AWS account.
#   cp ci/aws/infra/config.env.example ci/aws/infra/config.env

AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=705959604310

# CodeBuild project
CODEBUILD_PROJECT_NAME=guesttek-camsuite-edge
CODEBUILD_ROLE_NAME=codebuild-guesttek-camsuite-edge-service-role
CODEBUILD_COMPUTE_TYPE=BUILD_GENERAL1_MEDIUM
CODEBUILD_TIMEOUT_MINUTES=180

# GitHub orchestration source (this repo)
ORCHESTRATION_REPO=https://github.com/amitgupta2rsystems/guesttek_devops.git
CODECONNECTIONS_ARN=arn:aws:codeconnections:ap-south-1:705959604310:connection/cbb64a53-d797-4f8a-b11c-786fa83f174f

# S3
ARTIFACTS_BUCKET=guesttek-camsuite-edge-artifacts-705959604310
BUNDLES_BUCKET=guesttek-edge-bundles-705959604310
BUNDLES_PREFIX=guesttek/bundles/

# Secrets Manager (SSH deploy keys for service clones)
GIT_SSH_SECRET_NAME=guesttek/git-ssh-key

# Optional: IAM user who can start builds / download artifacts
TRIGGER_USER_NAME=guesttek-build
TRIGGER_POLICY_NAME=GuestTekCamsuiteEdgeCodeBuildStart
